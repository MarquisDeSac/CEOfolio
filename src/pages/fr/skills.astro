---
import StandardLayout from '~/layouts/StandardLayout.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import { experiences } from '~/data/experiences'
import { parcours } from '~/data/parcours'
import { withBasePath } from '~/utils/path'

// 1. Fetch All Data
const projects = await getCollection('projects')

// 2. Define Categories and SubGroups
const categories: Record<string, { color: string, subGroups: Record<string, string[]> }> = {
  'Moteur & Jeu Vidéo': {
    color: 'neon-pink',
    subGroups: {
      'Unity': ['Unity', 'C#'],
      'Godot & Unreal': ['Godot', 'Unreal'],
      'Réalité Étendue (XR)': ['VR', 'AR', 'XR', 'Réalité Virtuelle', 'Virtuelle'],
      'Web & Graphique': ['WebGL', 'Processing', 'Shader', '3D', '2D'],
      'Game Design': ['Game', 'Jeu', 'Level', 'Asset', 'Balance', 'Locomotion', 'Serious']
    }
  },
  'Programmation & Backend': {
    color: 'neon-blue',
    subGroups: {
      'Langages Systèmes': ['C', 'C++'],
      'IA & Data': ['Python', 'Data', 'IA', 'Intelligence', 'Algorithm', 'Structure'],
      'Java & Backend': ['Java', 'Spring', 'SQL', 'API', 'Rest', 'POO', 'Databases']
    }
  },
  'Web & Outils': {
    color: 'sunset-purple',
    subGroups: {
      'Frontend Web': ['HTML', 'CSS', 'JS', 'Thymeleaf', 'Web'],
      'Versionnement & CI': ['Git', 'Version', 'GitHub'],
      'Interopérabilité': ['Interop', 'Voice', 'STT', 'TTS']
    }
  },
  'Design & Soft Skills': {
    color: 'neon-blue',
    subGroups: {
      'UI / UX Design': ['UI', 'UX', 'Design', 'Interface'],
      'Gestion & Agile': ['Agile', 'Scrum', 'Chef', 'Gestion', 'Documentation', 'GDD', 'Management'],
      'Communication': ['Communication', 'Public', 'Speaking', 'English', 'Korean', 'Interculturel', 'Social'],
      'Audio & Narration': ['Audio', 'Narrative', 'Gamification']
    }
  }
}

// 3. Aggregate all raw skills and their sources
interface SkillSource { title: string; link: string; sourceType: string }
const rawSkills = new Map<string, SkillSource[]>()

function registerSkill(skillName: string, sourceItem: SkillSource) {
  const normSkill = skillName.trim()
  if (!rawSkills.has(normSkill)) {
    rawSkills.set(normSkill, [])
  }
  rawSkills.get(normSkill)!.push(sourceItem)
}

projects.forEach(p => {
  if (p.data.skills) {
    p.data.skills.forEach(s => registerSkill(s, { title: p.data.id, link: withBasePath(`/fr/projects/${p.data.id}`), sourceType: 'Project' }))
  }
})
experiences.fr.forEach(e => {
  if (e.skills) {
    e.skills.forEach(s => registerSkill(s, { title: e.role + ' @ ' + e.company, link: withBasePath('/fr/experiences'), sourceType: 'Exp' }))
  }
})
parcours.fr.forEach(p => {
  if (p.skills) {
    p.skills.forEach(s => registerSkill(s, { title: p.title, link: withBasePath('/fr/parcours'), sourceType: 'Education' }))
  }
})

// 4. Map raw skills into SubGroups
// We will build a tree: Category -> SubGroup -> Array of { rawSkillName, sources }
const categorizedData: Record<string, Record<string, { name: string; sources: SkillSource[] }[]>> = {}
Object.keys(categories).forEach(cat => {
  categorizedData[cat] = {}
  Object.keys(categories[cat].subGroups).forEach(sub => {
    categorizedData[cat][sub] = []
  })
})

rawSkills.forEach((sources, rawSkillName) => {
  let matched = false
  for (const [catName, catConfig] of Object.entries(categories)) {
    for (const [subName, keywords] of Object.entries(catConfig.subGroups)) {
      if (keywords.some(k => rawSkillName.toLowerCase().includes(k.toLowerCase()))) {
        categorizedData[catName][subName].push({ name: rawSkillName, sources })
        matched = true
        break
      }
    }
    if (matched) break
  }
  // Fallback if not matched
  if (!matched) {
    categorizedData['Design & Soft Skills']['Communication'].push({ name: rawSkillName, sources })
  }
})

// Remove empty subgroups
Object.keys(categorizedData).forEach(cat => {
  Object.keys(categorizedData[cat]).forEach(sub => {
    if (categorizedData[cat][sub].length === 0) {
      delete categorizedData[cat][sub]
    }
  })
})

const title = "Compétences"
const subtitle = "Stack Technique & Savoir-Être"
---

<BaseLayout
  title={title}
  description={subtitle}
  bgType="neon-plum"
  ogImage={false}
>
  <StandardLayout
    title={title}
    subtitle={subtitle}
    isCentered={true}
    articleClass="max-w-5xl!"
  >
    <div slot="article" class="py-10">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {Object.entries(categorizedData).map(([catName, subGroups]) => (
          Object.keys(subGroups).length > 0 && (
            <div class={`p-8 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 flex flex-col gap-6 hover:border-${categories[catName].color}/50 transition-colors group relative overflow-hidden`}>
              
              <!-- Header -->
              <div class="flex items-center gap-4 relative z-10 border-b border-black/5 dark:border-white/5 pb-4">
                <div class={`w-4 h-10 rounded-full bg-${categories[catName].color} flex-shrink-0 shadow-[0_0_15px_rgba(var(--c-${categories[catName].color}),0.5)]`}></div>
                <h3 class="text-2xl font-bold u-text-main m-0! p-0!">{catName}</h3>
              </div>

              <!-- Main Bubbles -->
              <div class="flex flex-wrap gap-4 relative z-10">
                {Object.entries(subGroups).map(([subName, rawSkillsList]) => (
                  <button 
                    onclick={`document.getElementById('modal-${subName.replace(/[^a-zA-Z0-9-]/g, '-')}')?.showModal()`}
                    class={`px-6 py-4 rounded-2xl border border-black/10 dark:border-white/10 bg-white/50 dark:bg-black/20 hover:bg-${categories[catName].color}/10 hover:border-${categories[catName].color}/50 transition-all cursor-pointer text-left relative group/bubble shadow-sm hover:shadow-[0_0_15px_rgba(var(--c-${categories[catName].color}),0.2)] hover:-translate-y-1`}
                  >
                    <div class="font-bold text-lg u-text-main group-hover/bubble:text-neon-blue transition-colors">{subName}</div>
                    <div class="text-sm opacity-60 u-text-muted mt-1">{rawSkillsList.length} tags associés</div>
                    
                    <!-- Notification dot if multiple projects -->
                    <span class={`absolute -top-2 -right-2 w-4 h-4 rounded-full bg-${categories[catName].color} shadow-lg opacity-80 animate-pulse`}></span>
                  </button>
                ))}
              </div>

              <!-- Bg Glow -->
              <div class={`absolute -bottom-10 -right-10 w-48 h-48 bg-${categories[catName].color} opacity-5 blur-3xl rounded-full group-hover:opacity-10 transition-opacity pointer-events-none`}></div>
            </div>
          )
        ))}
      </div>

    </div>

    <!-- Modals for SubGroups -->
    {Object.entries(categorizedData).flatMap(([catName, subGroups]) => 
      Object.entries(subGroups).map(([subName, rawSkillsList]) => (
        <dialog id={`modal-${subName.replace(/[^a-zA-Z0-9-]/g, '-')}`} class="backdrop:bg-black/80 backdrop:backdrop-blur-sm bg-transparent p-0 m-auto max-w-2xl w-full rounded-2xl shadow-2xl open:animate-fade-in z-50">
          <div class="bg-[#FCFCFC] dark:bg-[#0c0c0c] border border-black/10 dark:border-white/10 p-8 rounded-2xl relative overflow-hidden flex flex-col max-h-[85vh]">
              
              <form method="dialog">
                <button class="absolute top-6 right-6 u-text-main opacity-50 hover:opacity-100 transition-opacity cursor-pointer z-50 bg-black/5 dark:bg-white/5 p-2 rounded-full">
                  <div class="i-ri-close-line text-2xl"></div>
                </button>
              </form>

              <div class="mb-8 pr-12 flex-shrink-0">
                <h3 class="text-3xl font-bold u-text-main mb-2">
                  Domaine : <span class={`text-transparent bg-clip-text bg-gradient-to-r from-${categories[catName].color} to-neon-blue`}>{subName}</span>
                </h3>
                <p class="opacity-70 text-sm">Cliquez sur un projet ou une expérience ci-dessous pour le découvrir en détail.</p>
              </div>

              <div class="flex-grow overflow-y-auto custom-scrollbar pr-2 flex flex-col gap-6">
                {rawSkillsList.map(rawSkill => (
                  <div class="flex flex-col gap-3">
                    <div class={`inline-block px-4 py-1.5 rounded-full border border-${categories[catName].color}/30 bg-${categories[catName].color}/10 text-${categories[catName].color} font-bold text-sm w-fit`}>
                      Tag : {rawSkill.name}
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pl-4 border-l-2 border-black/10 dark:border-white/10 ml-2">
                      {rawSkill.sources.map(source => (
                        <a href={source.link} class="flex items-center gap-4 p-3 rounded-xl bg-black/5 dark:bg-white/5 hover:bg-black/10 dark:hover:bg-white/10 transition-colors group no-underline border border-transparent hover:border-black/10 dark:hover:border-white/10">
                          <div class={`p-2 rounded-lg flex-shrink-0 ${source.sourceType === 'Project' ? 'bg-neon-blue/20 text-neon-blue' : source.sourceType === 'Exp' ? 'bg-neon-pink/20 text-neon-pink' : 'bg-sunset-purple/20 text-sunset-purple'}`}>
                            <div class={source.sourceType === 'Project' ? 'i-ri-folder-line' : source.sourceType === 'Exp' ? 'i-ri-briefcase-line' : 'i-ri-graduation-cap-line'}></div>
                          </div>
                          <div class="flex flex-col min-w-0">
                            <span class="font-bold text-sm u-text-main group-hover:text-neon-blue transition-colors truncate">{source.title}</span>
                            <span class="text-xs opacity-50 uppercase tracking-widest u-text-main">{source.sourceType}</span>
                          </div>
                          <div class="ml-auto i-ri-arrow-right-s-line opacity-30 group-hover:opacity-100 u-text-main transition-all group-hover:-translate-x-1 flex-shrink-0"></div>
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>

          </div>
        </dialog>
      ))
    )}

  </StandardLayout>
</BaseLayout>

<style>
  dialog[open] {
    animation: zoom-in 0.2s ease-out;
  }
  @keyframes zoom-in {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #8884;
    border-radius: 3px;
  }
</style>

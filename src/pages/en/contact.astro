---
import StandardLayout from '~/layouts/StandardLayout.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'

const title = "Contact"
const subtitle = "Let's work together"
---

<BaseLayout
  title={title}
  description={subtitle}
  bgType="city-lights"
  ogImage={false}
>
  <StandardLayout
    title={title}
    subtitle={subtitle}
    isCentered={true}
    articleClass="max-w-2xl!"
  >
    <div slot="article" class="py-10">

      <!-- Contact Info Panel -->
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 p-8 mb-8 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
        <div class="flex items-center gap-4">
          <div class="p-3 rounded-full bg-neon-blue/20 text-neon-blue">
            <div class="i-ri-mail-send-line text-3xl"></div>
          </div>
          <div class="flex flex-col">
            <span class="text-sm font-bold uppercase tracking-widest opacity-70 mb-1">Professional Email</span>
            <a href="mailto:nino.sacchi.pro@gmail.com" class="text-xl font-bold u-text-main hover:text-neon-blue transition-colors no-underline!">nino.sacchi.pro@gmail.com</a>
          </div>
        </div>
        <div class="flex gap-4">
          <a href="https://github.com/MarquisDeSac" target="_blank" class="p-3 rounded-xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 hover:border-sunset-purple hover:text-sunset-purple transition-all group">
            <div class="i-simple-icons-github text-3xl group-hover:scale-110 transition-transform"></div>
          </a>
          <a href="https://www.linkedin.com/in/nino-sacchi-806aa9340/" target="_blank" class="p-3 rounded-xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 hover:border-neon-blue hover:text-neon-blue transition-all group">
            <div class="i-simple-icons-linkedin text-3xl group-hover:scale-110 transition-transform"></div>
          </a>
        </div>
      </div>
      
      <div class="p-8 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
        <form action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
            
            <input type="hidden" name="access_key" value="94023306-55a8-4c35-bccb-fdc26545a112">

            <!-- Name -->
            <div class="flex flex-col gap-2">
                <label for="name" class="text-sm font-bold uppercase tracking-widest opacity-70">Name</label>
                <input type="text" name="name" id="name" required class="px-4 py-3 rounded-lg bg-white/50 dark:bg-black/20 border border-black/10 dark:border-white/10 focus:border-neon-blue focus:outline-none transition-colors" placeholder="Your name" />
            </div>

            <!-- Email -->
            <div class="flex flex-col gap-2">
                <label for="email" class="text-sm font-bold uppercase tracking-widest opacity-70">Email</label>
                <input type="email" name="email" id="email" required class="px-4 py-3 rounded-lg bg-white/50 dark:bg-black/20 border border-black/10 dark:border-white/10 focus:border-neon-blue focus:outline-none transition-colors" placeholder="your@email.com" />
            </div>

            <!-- Message -->
            <div class="flex flex-col gap-2">
                <label for="message" class="text-sm font-bold uppercase tracking-widest opacity-70">Message</label>
                <textarea name="message" id="message" rows="5" required class="px-4 py-3 rounded-lg bg-white/50 dark:bg-black/20 border border-black/10 dark:border-white/10 focus:border-neon-blue focus:outline-none transition-colors resize-none" placeholder="Let's talk about your project..."></textarea>
            </div>

             <!-- Honeypot -->
             <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

            <button type="submit" class="w-full py-4 rounded-lg bg-neon-blue/10 border border-neon-blue/30 text-neon-blue font-bold hover:bg-neon-blue hover:text-black transition-all">
                Send Message
            </button>
            
            <p class="text-xs text-center opacity-50 mt-4">
                Powered by Web3Forms. No backend required.
            </p>
        </form>
      </div>

    </div>
  </StandardLayout>
</BaseLayout>
